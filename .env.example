# Copie ce fichier en .env et renseigne ton client_id d'app Azure AD.
#
# Comment l'obtenir :
#  1. https://portal.azure.com -> Azure Active Directory -> App registrations -> New registration
#  2. Supported account types : "Personal Microsoft accounts only"
#  3. Onglet Authentication -> "Allow public client flows" = Yes
#  4. Onglet API permissions : ajoute le scope Xbox Live "XboxLive.signin" (délégué)
#  5. Copie l'Application (client) ID ci-dessous
#
# Note : l'app doit être approuvée pour Minecraft, sinon login_with_xbox renvoie 403.
# Approbation : https://aka.ms/mce-reviewappid
MS_CLIENT_ID=

# --- Mises à jour automatiques ---
# AUTONOME : l'app se met à jour depuis les Releases GitHub du dépôt public
# saliox/snipe-mc. RIEN à configurer, AUCUNE adresse IP.
#
# Override optionnel (jamais une IP) :
#   UPDATE_REPO=owner/name   -> pointer un autre dépôt GitHub public
# UPDATE_REPO=

# --- Abonnement (gate d'accès) — OFF PAR DÉFAUT : app strictement inchangée si absent ---
# Poser ces 3 variables (dans le .env du build à gater) active un écran login + abonnement
# Stripe 3 €/mois au démarrage. Voir docs/subscription-setup.md pour tout brancher.
# SUB_GATE=1                                    # 1 = active le gate ; absent/autre = OFF
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...                       # clé ANON publique (JAMAIS la service_role)
# STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxx
# SUB_PRICE_LABEL=3 €/mois

# Mets DEBUG=1 pour afficher les stack traces complètes.
# DEBUG=1
